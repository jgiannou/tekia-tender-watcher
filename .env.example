NODE_ENV=development
PORT=3000

# Local: ./data/tenders.db
# Coolify: MUST be /data/tenders.db (absolute). Relative paths write outside the volume.
# Phase 1: SQLite remains the live watcher database until Postgres cutover.
DATABASE_PATH=./data/tenders.db

# PostgreSQL (Prisma) — local default matches docker-compose.yml
# Used by SaaS (Prisma) only. Internal watcher still uses DATABASE_PATH / SQLite.
DATABASE_URL=postgresql://tekia:tekia@127.0.0.1:5432/tekia_tender_watcher?schema=public
# SaaS vitest suite only (never point this at your dev DB — resets wipe users).
# SAAS_TEST_DATABASE_URL=postgresql://tekia:tekia@127.0.0.1:5432/tekia_tender_watcher_test?schema=public

# SaaS auth (Better Auth). Not used by the internal Electron/SQLite tool.
# Set SAAS_ENABLED=true to mount /api/auth/* and /api/saas/* on the same process.
SAAS_ENABLED=false
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://127.0.0.1:3000
SAAS_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SAAS_APP_URL=http://127.0.0.1:5174
# Production (Coolify): https://arc-tenders.tekia.gr for BETTER_AUTH_URL + SAAS_APP_URL
# See docs/ops-setup.md §9

# Brevo SMTP (transactional: verify email + password reset). Off unless EMAIL_ENABLED=true.
EMAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=contact@tekia.gr
EMAIL_FROM_NAME=ARC Tenders
EMAIL_LOCALE=el

# Stripe (same TEKIA account as ARC Procurement — NEW Tenders products/prices)
# Full checklist: docs/ops-setup.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TENDERS_BASIC_MONTHLY=
STRIPE_PRICE_TENDERS_BASIC_ANNUAL=
STRIPE_PRICE_TENDERS_PRO_MONTHLY=
STRIPE_PRICE_TENDERS_PRO_ANNUAL=
STRIPE_PRICE_TENDERS_EXTRA_SEAT_MONTHLY=
STRIPE_PRICE_TENDERS_EXTRA_SEAT_ANNUAL=
STRIPE_SUCCESS_URL=http://127.0.0.1:5174/app/subscription?checkout=success
STRIPE_CANCEL_URL=http://127.0.0.1:5174/app/subscription?checkout=cancel

# External public sources (no API keys for read/search)
# TED Search API is unauthenticated; set TED_ENABLED=true to expose /api/saas/sources/ted/*
TED_ENABLED=false
# TED_API_BASE_URL=https://api.ted.europa.eu
# Diavgeia OpenData/luminapi public reads; set DIAVGEIA_ENABLED=true for adapter routes
DIAVGEIA_ENABLED=false
# DIAVGEIA_BASE_URL=https://diavgeia.gov.gr/opendata
# DIAVGEIA_SEARCH_URL=https://diavgeia.gov.gr/luminapi/opendata/search.json

POLL_INTERVAL_MINUTES=5
LOOKBACK_HOURS=168

MIN_BUDGET=1500
MAX_BUDGET=30000
ALERT_SCORE_THRESHOLD=60

BOOTSTRAP_SEND_ALERTS=false

SLACK_WEBHOOK_URL=
ADMIN_TOKEN=

# Operator dashboard API (local dashboard → cloud watcher)
OPERATOR_API_TOKEN=
LOCAL_DASHBOARD_URL=http://localhost:5173
LOCAL_DASHBOARD_ORIGINS=http://localhost:5173

KIMDIS_BASE_URL=https://cerpp.eprocurement.gov.gr

# Google Drive OAuth belongs ONLY to the Electron desktop app.
# Configure in: apps/desktop/.env  (see apps/desktop/.env.example)
# Never put Google tokens or GOOGLE_OAUTH_* into Coolify / cloud watcher.
