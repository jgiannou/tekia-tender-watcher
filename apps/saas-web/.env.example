# Optional absolute API origin. Leave unset to use Vite proxy (/api → :3000).
# VITE_SAAS_API_URL=http://127.0.0.1:3000

# Google tags (public client IDs). Defaults exist in code; override if needed.
# GTM is the only script loader — configure GA4 + AW inside the container.
# Do not paste snippets into index.html.
# VITE_GTM_ID=GTM-KJ8T4GQ4
# VITE_GA4_MEASUREMENT_ID=G-WG2W3WE5QD
# VITE_GOOGLE_ADS_ID=AW-18392529196
# Full send_to for Free Signup conversion (ID/label) — fired via gtag event
# VITE_GOOGLE_ADS_SIGNUP_CONVERSION=AW-18392529196/xvBLCNXjwZkdEKzynsJE
