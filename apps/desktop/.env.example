# Electron desktop — Google Drive OAuth (Main process only)
# Never use VITE_* for these values.
# Do not commit real credentials.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Default (do not broaden without an explicit operator decision):
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file openid email profile

# Do NOT put the TEKIA/Tenders folder ID here — select it in Settings UI.
