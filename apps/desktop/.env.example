# Electron desktop — Google Drive OAuth (Main process only)
# Never use VITE_* for these values.
# Do not commit real credentials.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Operator-approved scope (2026-09-30):
# - drive.readonly: read existing TEKIA/Tenders vault hierarchy
# - drive.file: create tender workspaces + copy templates + Docs merge on copies
# Docs API (Enable in Google Cloud Console) reuses these scopes — no extra scope.
# Do NOT use full https://www.googleapis.com/auth/drive unless explicitly required.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file openid email profile

# Do NOT put the TEKIA/Tenders folder ID here — select it in Settings UI.
