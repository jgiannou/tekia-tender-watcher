{
  "expo": {
    "name": "ARC Tenders",
    "slug": "arc-tenders",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "arctenders",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arctenders.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/brand/icon.png"
      },
      "package": "com.arctenders.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon.png",
          "color": "#00f3ff",
          "sounds": [],
          "defaultChannel": "arc-tenders-alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77367e8b-b5e9-4f66-885a-99832b68e1b8"
      }
    },
    "owner": "jgiann"
  }
}
