// TEKIA Tender Watcher — SaaS PostgreSQL schema (additive product)
// Internal Electron/SQLite tool does NOT use this database.
// See docs/SAAS_PRODUCT_NORTH_STAR.md
//
// Prisma 6.x + PostgreSQL + Node 22

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (Better Auth–compatible shapes; wired in Phase 2)
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Last password issued via Ops Desk (plaintext; ops-only). Null when cleared/disabled.
  opsPassword   String?
  opsPasswordAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     OrganizationMember[]
  invitationsSent Invitation[] @relation("InvitationInviter")
  preference  UserPreference?
  legalAcceptance LegalAcceptance?
  pushDevices PushDevice[]
  slackInstallations OrganizationSlackConnection[] @relation("SlackInstalledBy")
  googleConnections  UserOrganizationGoogleConnection[]
  promotionActivations OrganizationPromotionRedemption[] @relation("PromotionActivatedBy")

  @@map("users")
}

/// Proof of Terms + Privacy acceptance at signup (or later re-accept).
model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String   @unique
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  /// signup | reaccept
  source         String   @default("signup")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([acceptedAt])
  @@map("legal_acceptances")
}

/// Per-user UI preferences (theme belongs to the user, not the organization).
model UserPreference {
  id                String          @id @default(cuid())
  userId            String          @unique
  theme             ThemePreference @default(DARK)
  /// Master switch for mobile lock-screen / sound push notifications.
  mobilePushEnabled Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Expo push tokens for mobile devices (per user).
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("push_devices")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  invitations      Invitation[]
  subscription     Subscription?
  promotionRedemptions OrganizationPromotionRedemption[]
  watchProfiles    WatchProfile[]
  organizationTenders OrganizationTender[]
  settings         OrganizationSettings?
  alertDestinations AlertDestination[]
  submissions      Submission[]
  tenderEvents     TenderEvent[]
  outreachLedgers  OutreachLedger[]
  attentionEvents  OrganizationAttentionEvent[]
  notificationDeliveries NotificationDelivery[]
  saasJobs           SaasJob[]
  vaultFolders       VaultFolder[]
  vaultDocuments     VaultDocument[]
  vaultDocumentVersions VaultDocumentVersion[]
  tenderWorkspaces   TenderWorkspace[]
  submissionDocumentSnapshots SubmissionDocumentSnapshot[]
  slackConnection    OrganizationSlackConnection?
  googleConnections  UserOrganizationGoogleConnection[]

  @@map("organizations")
}

enum SlackConnectionStatus {
  ACTIVE
  PAUSED
  /// Sends stopped until admin re-enables after upgrade from Free.
  PLAN_PAUSED
  /// Webhook revoked / permanent delivery failure — needs reconnect.
  NEEDS_RECONNECT
  DISCONNECTED
}

/// Customer Slack incoming-webhook connection (one channel per organization).
/// Never reuse the internal SLACK_WEBHOOK_URL env for these rows.
model OrganizationSlackConnection {
  id                   String                @id @default(cuid())
  organizationId       String                @unique
  status               SlackConnectionStatus @default(PAUSED)
  slackTeamId          String
  slackTeamName        String
  slackChannelId       String
  slackChannelName     String
  /// AES-GCM ciphertext of hooks.slack.com webhook URL (never plaintext).
  webhookUrlCiphertext String
  webhookUrlNonce      String
  installedByUserId    String?
  /// Preferences independent of email: { newOpportunity, relatedActOnFollowed, deadlineRadar }
  preferences          Json                  @default("{}")
  /// false until admin saves preferences after first OAuth connect.
  notificationsArmed   Boolean               @default(false)
  lastTestSentAt       DateTime?
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  /// Safe, truncated error code/message — never includes webhook URL.
  lastErrorSafe        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installedBy  User?        @relation("SlackInstalledBy", fields: [installedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("organization_slack_connections")
}

/// Single-use OAuth state for Slack install (bound to user + organization).
model SlackOAuthState {
  id             String   @id @default(cuid())
  state          String   @unique
  userId         String
  organizationId String
  /// CONNECT | REPLACE
  purpose        String   @default("CONNECT")
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, organizationId])
  @@index([expiresAt])
  @@map("slack_oauth_states")
}

/// Capability status for a Google integration (Calendar / Drive / Sheets).
enum GoogleCapabilityStatus {
  DISABLED
  ACTIVE
  PAUSED
  PLAN_PAUSED
  NEEDS_RECONNECT
  /// Calendar/sheets resource missing — needs explicit recreate.
  NEEDS_RECREATE
  /// First sync / setup still running.
  SYNCING
}

/**
 * Personal Google connection bound to user + organization.
 * One Google account per user/org. Tokens encrypted at rest.
 * Capabilities (Calendar/Drive/Sheets) use incremental OAuth scopes.
 */
model UserOrganizationGoogleConnection {
  id                     String   @id @default(cuid())
  organizationId         String
  userId                 String
  googleAccountId        String
  googleEmail            String
  /// AES-GCM ciphertext of refresh token (never plaintext / never in outbox).
  refreshTokenCiphertext String
  refreshTokenNonce      String
  accessTokenCiphertext  String?
  accessTokenNonce       String?
  accessTokenExpiresAt   DateTime?
  /// Space-separated granted scopes from Google token response.
  grantedScopes          String   @default("")
  tokenStatus            GoogleCapabilityStatus @default(ACTIVE)

  calendarStatus         GoogleCapabilityStatus @default(DISABLED)
  calendarId             String?
  calendarHtmlLink       String?
  calendarSummary        String?
  calendarLastSuccessAt  DateTime?
  calendarLastErrorAt    DateTime?
  calendarLastErrorSafe  String?
  calendarInitialSyncAt  DateTime?

  driveStatus            GoogleCapabilityStatus @default(DISABLED)
  driveLastSuccessAt     DateTime?
  driveLastErrorAt       DateTime?
  driveLastErrorSafe     String?

  sheetsStatus           GoogleCapabilityStatus @default(DISABLED)
  spreadsheetId          String?
  spreadsheetUrl         String?
  sheetsLastSuccessAt    DateTime?
  sheetsLastErrorAt      DateTime?
  sheetsLastErrorSafe    String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEvents GoogleCalendarEventLink[]
  driveFolders   GoogleDriveFolderLink[]
  driveImports   GoogleDriveImportRecord[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([calendarStatus])
  @@map("user_organization_google_connections")
}

model GoogleOAuthState {
  id             String   @id @default(cuid())
  state          String   @unique
  userId         String
  organizationId String
  /// CONNECT | REPLACE | INCREMENTAL
  purpose        String   @default("CONNECT")
  /// calendar | drive | sheets (comma-separated for combined grants)
  capabilities   String
  /// PKCE code_verifier (plaintext short-lived; deleted after exchange)
  codeVerifier   String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, organizationId])
  @@index([expiresAt])
  @@map("google_oauth_states")
}

/// Maps an org tender deadline to a Google Calendar event (idempotent sync).
model GoogleCalendarEventLink {
  id                   String   @id @default(cuid())
  connectionId         String
  organizationTenderId String
  tenderId             String
  googleCalendarId     String
  googleEventId        String
  /// Fingerprint of synced deadline payload (date/time/title) for change detection.
  deadlineFingerprint  String
  lastSyncedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  connection UserOrganizationGoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, organizationTenderId])
  @@index([connectionId, googleEventId])
  @@index([tenderId])
  @@map("google_calendar_event_links")
}

/// Maps a tender to a Drive folder snapshot created by ARC (Phase 3).
enum GoogleDriveFolderStatus {
  PENDING
  SUCCEEDED
  /// Folder exists but some files failed / are still missing — retry resumes only those.
  PARTIAL
  FAILED
}

enum GoogleDriveFolderItemStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Deliberately not copied (e.g. official PDF unavailable → link-only).
  SKIPPED
}

/// One immutable tender snapshot folder in the user's Google Drive (Phase 3).
/// A new snapshot is a new row + a new Drive folder — existing folders are never mutated.
model GoogleDriveFolderLink {
  id                   String   @id @default(cuid())
  connectionId         String
  organizationId       String
  organizationTenderId String
  tenderId             String
  createdByUserId      String
  /// Google account the folder was created in (stale-job guard after account switch).
  googleAccountId      String
  googleEmail          String
  /// Null until the root folder exists in Drive.
  folderId             String?
  folderUrl            String?
  folderName           String
  /// Idempotency key for "start" (client request id) — unique per connection + tender.
  snapshotKey          String
  status               GoogleDriveFolderStatus @default(PENDING)
  /// Safe machine code only (never tokens or raw Google bodies).
  errorSafe            String?
  /// Selection made by the user (IDs and booleans only).
  options              Json     @default("{}")
  /// Bumped on every retry so superseded outbox jobs skip themselves.
  jobEpoch             Int      @default(0)
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  connection UserOrganizationGoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  items      GoogleDriveFolderItem[]

  @@unique([connectionId, organizationTenderId, folderId], map: "gdrive_folder_links_conn_tender_folder_key")
  @@unique([connectionId, organizationTenderId, snapshotKey], map: "gdrive_folder_links_conn_tender_snapshot_key")
  @@index([connectionId, organizationTenderId])
  @@index([organizationId, status])
  @@map("google_drive_folder_links")
}

/// A sub-folder or file planned for / written into a snapshot folder.
model GoogleDriveFolderItem {
  id          String                      @id @default(cuid())
  linkId      String
  /// Deterministic per link (section:01, summary, official:PROC:…, vault:<id>, checklist).
  itemKey     String
  /// SUBFOLDER | SUMMARY | OFFICIAL_PDF | VAULT_DOCUMENT | CHECKLIST
  kind        String
  /// 01 | 02 | 03 — null for root-level items.
  section     String?
  displayName String
  /// Vault document id or "<recordType>:<adam>".
  sourceRef   String?
  sortOrder   Int
  status      GoogleDriveFolderItemStatus @default(PENDING)
  driveFileId String?
  errorSafe   String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  link GoogleDriveFolderLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, itemKey])
  @@index([linkId, status])
  @@map("google_drive_folder_items")
}

enum GoogleDriveImportStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One file copied from Google Drive into the company vault (Phase 2).
/// Copy only — no live sync. Re-importing the same Drive file creates a new vault document.
model GoogleDriveImportRecord {
  id                 String                  @id @default(cuid())
  connectionId       String
  organizationId     String
  userId             String
  /// Null until the copy succeeded; SetNull when the vault document is deleted.
  vaultDocumentId    String?
  googleFileId       String
  googleFileName     String
  googleMimeType     String
  googleModifiedTime DateTime?
  googleMd5Checksum  String?
  /// Drive `version` (monotonic counter) at import time.
  googleVersion      String?
  /// Set when a Google Doc was exported (e.g. application/pdf).
  exportMimeType     String?
  /// ARC vault folder the copy is stored in.
  targetFolderId     String
  status             GoogleDriveImportStatus @default(PENDING)
  /// Safe machine code only (never tokens or raw Google bodies).
  errorSafe          String?
  importedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  connection    UserOrganizationGoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  vaultDocument VaultDocument?                   @relation(fields: [vaultDocumentId], references: [id], onDelete: SetNull)

  @@index([connectionId, status])
  @@index([organizationId, userId, status])
  @@index([googleFileId])
  @@index([vaultDocumentId])
  @@map("google_drive_import_records")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String     @id @default(cuid())
  organizationId String
  email          String
  role           MemberRole @default(MEMBER)
  status         String     @default("pending")
  token          String     @unique
  expiresAt      DateTime
  inviterId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Billing (Phase 6 — tables exist early for clean FKs)
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  /// Public catalog keys: trial | basic | pro (legacy starter_499/pro_1000 normalized in code).
  planKey              String             @default("trial")
  stripePriceId        String?
  /// Paid seat add-ons beyond plan.includedSeats (Pro only). Not a third plan.
  extraSeats           Int                @default(0)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
  payload     Json?

  @@map("stripe_webhook_events")
}

/// Cardless promotional Pro access (e.g. ARC_PRO_LAUNCH_30).
/// Separate from Stripe subscriptions and from the 7-day Pro preview.
enum OrganizationPromotionStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  REVOKED
}

enum PromotionActivationSource {
  SELF_SERVICE
  ADMIN
}

model OrganizationPromotionRedemption {
  id                    String                       @id @default(cuid())
  organizationId        String
  promotionKey          String
  activatedByUserId     String
  activatedAt           DateTime
  expiresAt             DateTime
  status                OrganizationPromotionStatus  @default(ACTIVE)
  source                PromotionActivationSource    @default(SELF_SERVICE)
  /// Whether this redemption currently consumes a global capacity slot.
  slotConsumed          Boolean                      @default(true)
  slotRestoredAt        DateTime?
  revokedAt             DateTime?
  revokedBy             String?
  revokeReason          String?
  /// Optional UTM / campaign attribution (non-PII).
  attribution           Json?
  activationEmailSentAt DateTime?
  reminder7dSentAt      DateTime?
  reminder2dSentAt      DateTime?
  expiredNotifiedAt     DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activatedBy  User         @relation("PromotionActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, promotionKey])
  @@index([promotionKey, status])
  @@index([promotionKey, slotConsumed])
  @@index([status, expiresAt])
  @@map("organization_promotion_redemptions")
}

/// DB-backed capacity for a promotion. Survives restarts; env only seeds/ceiling.
model PromotionCampaignConfig {
  promotionKey String   @id
  capacity     Int
  updatedAt    DateTime @updatedAt
  updatedBy    String?
  note         String?

  @@map("promotion_campaign_configs")
}

/// Append-only admin/ops audit ledger for promotion mutations.
model PromotionAuditEvent {
  id               String   @id @default(cuid())
  promotionKey     String
  actionType       String
  organizationId   String?
  redemptionId     String?
  previousCapacity Int?
  newCapacity      Int?
  previousStatus   String?
  newStatus        String?
  reason           String
  performedBy      String
  idempotencyKey   String?  @unique
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([promotionKey, createdAt])
  @@index([organizationId, createdAt])
  @@map("promotion_audit_events")
}

// ---------------------------------------------------------------------------
// Watch profiles (tenant filter configuration)
// ---------------------------------------------------------------------------

model WatchProfile {
  id                    String   @id @default(cuid())
  organizationId        String
  name                  String
  enabled               Boolean  @default(true)
  presetKey             String?
  keywords              Json     @default("[]")
  negativeKeywords      Json     @default("[]")
  cpvs                  Json     @default("[]")
  minBudget             Float?
  maxBudget             Float?
  scoreThreshold        Int      @default(45)
  alertScoreThreshold   Int      @default(60)
  categories            Json?
  notificationThreshold Int?
  customFilters         Json?
  recordTypes           Json     @default("[\"REQ\",\"PROC\"]")
  matchingMode          String   @default("BALANCED")
  notificationOverride  String   @default("INHERIT")
  scanState             String   @default("PENDING")
  lastScannedAt         DateTime?
  initialScanCompletedAt DateTime?
  lastMatchAt           DateTime?
  matchCount            Int      @default(0)
  authority             String?
  contractType          String?
  procedureType         String?
  /// Optional KIMDIS publication window (YYYY-MM-DD). Null = rolling default lookback.
  dateFrom              String?
  dateTo                String?
  /// Greek NUTS 2 codes (EL30, EL41, …). Empty = all of Greece.
  regions               Json     @default("[]")
  /// When regions are set, also keep acts with no official NUTS.
  includeUnclassifiedRegion Boolean @default(false)
  /// Acts skipped in the latest match cycle because NUTS was missing.
  unclassifiedRegionCount   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationTenders OrganizationTender[]

  @@index([organizationId, enabled])
  @@map("watch_profiles")
}

// ---------------------------------------------------------------------------
// Canonical KIMDIS tender (global, deduped by ADAM)
// ---------------------------------------------------------------------------

enum RecordType {
  REQ
  PROC
  AWRD
  CONTRACT
  OTHER
}

model Tender {
  id                        String     @id @default(cuid())
  referenceNumber           String     @unique
  recordType                RecordType
  title                     String?
  /// KIMDIS objectDetails shortDescription(s) — «Περιληπτική περιγραφή».
  description               String?
  contractingAuthority      String?
  submissionDate            DateTime?
  signedDate                DateTime?
  finalSubmissionDate       DateTime?
  budgetWithoutVat          Float?
  budgetWithVat             Float?
  cpvs                      Json       @default("[]")
  stage                     String?
  targetedSupplier          Boolean    @default(false)
  nonInvitedOffersRejected  Boolean    @default(false)
  pdfTextStatus             String?
  pdfText                   String?
  officialPdfUrl            String?
  publicKimdisUrl           String?
  /// Official KIMDIS nutsCode.key (NUTS 2 or 3). Never inferred from the title.
  nutsCode                  String?
  contractEndsAt            DateTime?
  awardAmount               Float?
  winnerName                String?
  diavgeiaAda               String?
  diavgeiaUrl               String?
  rawJson                   Json?
  sourceFingerprint         String?
  classificationVersion     Int?
  parentTenderId            String?
  relationCandidateId       String?
  firstSeenAt               DateTime
  lastSeenAt                DateTime
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  parentTender      Tender?  @relation("TenderParent", fields: [parentTenderId], references: [id], onDelete: SetNull)
  childTenders      Tender[] @relation("TenderParent")
  organizationTenders OrganizationTender[]
  relatedActsAsSource  RelatedActLink[] @relation("RelatedActSource")
  relatedActsAsRelated RelatedActLink[] @relation("RelatedActRelated")
  attentionEventsAsRelated OrganizationAttentionEvent[] @relation("AttentionRelatedTender")

  @@index([recordType])
  @@index([lastSeenAt])
  @@index([parentTenderId])
  @@index([contractEndsAt])
  @@index([nutsCode])
  @@map("tenders")
}

// ---------------------------------------------------------------------------
// Organization-specific match / workflow state
// ---------------------------------------------------------------------------

enum RelevanceStatus {
  RELEVANT
  NEEDS_REVIEW
  IRRELEVANT
  EXPIRED
  TARGETED
}

enum OperationalStatus {
  NEW
  REVIEW
  READY
  SUBMITTED
  WON
  LOST
}

enum MonitoringReason {
  USER_FOLLOWING
  OUTREACH_SENT
  SUBMISSION_RECORDED
}

/// Pro Priority Monitoring intensity (Παρακολούθηση Προτεραιότητας).
enum MonitoringPriority {
  NORMAL
  PRIORITY
}

enum PriorityMonitoringReason {
  FOLLOW
  OUTREACH
  MANUAL
}

/// Organization workflow only. FOLLOWING and monitoring are separate booleans.
enum PipelineStage {
  NEW
  REVIEWING
  OUTREACH_SENT
  PREPARING
  SUBMITTED
  WON
  LOST
  CLOSED
  DISMISSED
}

model OrganizationTender {
  id                      String            @id @default(cuid())
  organizationId          String
  tenderId                String
  watchProfileId          String?
  relevanceStatus         RelevanceStatus?
  score                   Int?
  scoreReasons            Json?
  webRelevant             Boolean           @default(false)
  webCategory             String?
  ignoreReason            String?
  reviewReason            String?
  matchedKeywords         Json?
  matchedCpvs             Json?
  matchMeta               Json?
  classificationVersion   Int?
  alertEligibilityReason  String?
  operationalStatus       OperationalStatus @default(NEW)
  pipelineStage           PipelineStage     @default(NEW)

  /// Explicit «Παρακολούθηση» / «Με ενδιαφέρει» — not outreach, not submission.
  following               Boolean           @default(false)
  followedAt              DateTime?
  followedByUserId        String?

  /// Active related-act monitoring (continues after outreach/submit until stopped).
  monitoringActive        Boolean           @default(false)
  monitoringReason        MonitoringReason?
  monitoringStartedAt     DateTime?
  monitoringStoppedAt     DateTime?
  lastRelatedCheckAt      DateTime?
  latestRelatedActAt      DateTime?
  lastMonitoringNotificationAt DateTime?

  /// Pro-only high-frequency related-act watch (Hot Watch). Shared ingest stays global.
  monitoringPriority           MonitoringPriority @default(NORMAL)
  priorityMonitoringSince      DateTime?
  priorityMonitoringReason     PriorityMonitoringReason?
  lastPriorityCheckAt          DateTime?
  nextPriorityCheckAt          DateTime?
  priorityMonitoringLastError  String?
  priorityMonitoringErrorCount Int                @default(0)

  notifiedAt              DateTime?
  assignedMemberId        String?
  notes                   String?
  contactName             String?
  contactDepartment       String?
  contactEmail            String?
  contactPhone            String?
  submissionMethod        String?
  submissionEmail         String?
  submissionPortal        String?
  submissionInstructions  String?
  scopeSummary            String?
  documentChecklist       Json?
  drafts                  Json?
  approvalStatus          String?
  approvalSnapshot        Json?
  approvedAt              DateTime?
  relationConfidence      String?
  relationMethod          String?
  relationScore           Int?
  relationReasons         Json?
  invitationType          String?
  invitedVendorName       String?
  ourInvitationStatus     String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender       Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  watchProfile WatchProfile? @relation(fields: [watchProfileId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  events       TenderEvent[]
  outreachLedger OutreachLedger?
  attentionEvents OrganizationAttentionEvent[]
  notificationDeliveries NotificationDelivery[]
  tenderWorkspace   TenderWorkspace?

  @@unique([organizationId, tenderId])
  @@index([organizationId, operationalStatus])
  @@index([organizationId, relevanceStatus])
  @@index([organizationId, following])
  @@index([organizationId, monitoringActive])
  @@index([organizationId, monitoringPriority])
  @@index([monitoringPriority, nextPriorityCheckAt])
  @@index([organizationId, pipelineStage])
  @@index([organizationId, notifiedAt])
  @@index([watchProfileId])
  @@map("organization_tenders")
}

// ---------------------------------------------------------------------------
// Workflow ledgers (org-scoped)
// ---------------------------------------------------------------------------

enum SubmissionResult {
  PENDING
  WON
  LOST
}

model Submission {
  id                     String           @id @default(cuid())
  organizationId         String
  organizationTenderId   String
  submittedAt            DateTime
  submissionMethod       String
  recipient              String?
  subject                String?
  amountWithoutVat       Float?
  amountWithVat          Float?
  attachments            Json?
  externalReference      String?
  /// User who recorded the submission. The app does not submit to the authority.
  submittedByUserId      String?
  result                 SubmissionResult @default(PENDING)
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationTender OrganizationTender @relation(fields: [organizationTenderId], references: [id], onDelete: Cascade)
  documentSnapshots  SubmissionDocumentSnapshot[]

  @@index([organizationId, result])
  @@index([organizationTenderId])
  @@map("submissions")
}

model TenderEvent {
  id                   String   @id @default(cuid())
  organizationId       String
  organizationTenderId String
  eventType            String
  note                 String?
  createdAt            DateTime @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationTender OrganizationTender @relation(fields: [organizationTenderId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationTenderId, createdAt])
  @@map("tender_events")
}

model OutreachLedger {
  id                   String   @id @default(cuid())
  organizationId       String
  organizationTenderId String   @unique
  status               String   @default("NOT_STARTED")
  subject              String?
  body                 String?
  notes                String?
  recipient            String?
  sentAt               DateTime?
  payload              Json?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationTender OrganizationTender @relation(fields: [organizationTenderId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, sentAt])
  @@map("outreach_ledgers")
}

// ---------------------------------------------------------------------------
// Settings & alerts
// ---------------------------------------------------------------------------

model OrganizationSettings {
  id               String           @id @default(cuid())
  organizationId   String           @unique
  /// Persisted company profile (GEMI enrichment is optional provenance).
  company          Json
  /// OrganizationActivity rows: [{ code, description, isPrimary, source? }]
  activities       Json             @default("[]")
  /// Email notification preferences (SaaS; no Slack).
  notifications    Json?
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  /// Resume metadata: { step?, dismissedAt?, completedAt? }
  onboardingMeta   Json?
  drive            Json?
  documents        Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

enum AlertChannel {
  EMAIL
  IN_APP
  /// Reserved; SaaS product uses Brevo email. Internal tool keeps Slack outside Prisma.
  SLACK
}

model AlertDestination {
  id             String       @id @default(cuid())
  organizationId String
  channel        AlertChannel
  name           String?
  enabled        Boolean      @default(true)
  config         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel, enabled])
  @@map("alert_destinations")
}

// ---------------------------------------------------------------------------
// Canonical related acts + org attention + delivery (SaaS core)
// ---------------------------------------------------------------------------

enum RelationConfidence {
  CONFIRMED
  LIKELY
  POSSIBLE
  DISMISSED
}

/// Canonical procurement relation (NOT per-tenant).
/// Example: REQ A → PROC B exists once globally.
model RelatedActLink {
  id              String             @id @default(cuid())
  sourceTenderId  String
  targetTenderId  String
  relationType    String
  /// CONFIRMED | LIKELY | POSSIBLE | DISMISSED
  confidence      RelationConfidence @default(LIKELY)
  detectionMethod String
  payload         Json?
  createdAt       DateTime           @default(now())
  confirmedAt     DateTime?
  updatedAt       DateTime           @updatedAt

  sourceTender Tender @relation("RelatedActSource", fields: [sourceTenderId], references: [id], onDelete: Cascade)
  targetTender Tender @relation("RelatedActRelated", fields: [targetTenderId], references: [id], onDelete: Cascade)
  attentionEvents OrganizationAttentionEvent[]

  @@unique([sourceTenderId, targetTenderId, relationType])
  @@index([sourceTenderId])
  @@index([targetTenderId])
  @@index([confidence])
  @@map("related_act_links")
}

enum AttentionEventType {
  NEW_OPPORTUNITY
  OPPORTUNITY_DIGEST
  OUTREACH_RECORDED
  SUBMISSION_RECORDED
  RELATED_PROC_DISCOVERED
  RELATED_APPROVED_REQUEST_DISCOVERED
  RELATED_AWARD_DISCOVERED
  RELATED_CONTRACT_DISCOVERED
  DEADLINE_CHANGED
  DEADLINE_APPROACHING
}

/// Org-specific "needs attention" fact. System of record for in-app attention.
/// Independent of email delivery success.
model OrganizationAttentionEvent {
  id                   String             @id @default(cuid())
  organizationId       String
  organizationTenderId String
  relatedTenderId      String?
  relatedActLinkId     String?
  type                 AttentionEventType
  title                String
  metadata             Json?
  dedupeKey            String
  createdAt            DateTime           @default(now())
  readAt               DateTime?

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationTender OrganizationTender @relation(fields: [organizationTenderId], references: [id], onDelete: Cascade)
  relatedTender      Tender?            @relation("AttentionRelatedTender", fields: [relatedTenderId], references: [id], onDelete: SetNull)
  relatedActLink     RelatedActLink?    @relation(fields: [relatedActLinkId], references: [id], onDelete: SetNull)
  deliveries         NotificationDelivery[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, readAt])
  @@index([organizationTenderId, createdAt])
  @@map("organization_attention_events")
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Transport attempt only (Brevo later). Never the source of truth for "what happened".
model NotificationDelivery {
  id                       String                     @id @default(cuid())
  organizationId           String
  organizationAttentionEventId String
  organizationTenderId     String?
  channel                  AlertChannel
  templateKey              String
  dedupeKey                String
  status                   NotificationDeliveryStatus @default(PENDING)
  subject                  String?
  bodyPreview              String?
  providerMessageId        String?
  error                    String?
  payload                  Json?
  createdAt                DateTime                   @default(now())
  sentAt                   DateTime?

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attentionEvent     OrganizationAttentionEvent  @relation(fields: [organizationAttentionEventId], references: [id], onDelete: Cascade)
  organizationTender OrganizationTender?         @relation(fields: [organizationTenderId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationAttentionEventId])
  @@index([organizationId, createdAt])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Company vault (org-scoped document library)
// ---------------------------------------------------------------------------

enum VaultDocumentStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  NO_EXPIRY
}

enum VaultDocumentSource {
  USER_UPLOAD
  GEMI
  GENERATED
  IMPORTED
}

model VaultFolder {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  sortOrder      Int      @default(0)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       VaultFolder?  @relation("VaultFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     VaultFolder[] @relation("VaultFolderTree")
  documents    VaultDocument[]

  @@index([organizationId, parentId])
  @@index([organizationId, parentId, slug])
  @@map("vault_folders")
}

model VaultDocument {
  id               String              @id @default(cuid())
  organizationId   String
  folderId         String
  name             String
  originalFilename String?
  documentType     String?
  mimeType         String?
  storageKey       String?
  fileSize         Int?
  checksum         String?
  issueDate        DateTime?
  expiryDate       DateTime?
  noExpiry         Boolean             @default(true)
  status           VaultDocumentStatus @default(NO_EXPIRY)
  version          Int                 @default(1)
  notes            String?
  source           VaultDocumentSource @default(USER_UPLOAD)
  uploadedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder         VaultFolder                  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  versions       VaultDocumentVersion[]
  workspaceRefs  TenderWorkspaceDocumentRef[]
  submissionSnapshots SubmissionDocumentSnapshot[]
  googleDriveImports  GoogleDriveImportRecord[]

  @@index([organizationId, folderId])
  @@index([organizationId, name])
  @@map("vault_documents")
}

/// Immutable file history for a company vault document.
model VaultDocumentVersion {
  id               String   @id @default(cuid())
  organizationId   String
  documentId       String
  version          Int
  storageKey       String
  originalFilename String?
  mimeType         String?
  fileSize         Int?
  checksum         String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     VaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspaceRefs TenderWorkspaceDocumentRef[]
  submissionSnapshots SubmissionDocumentSnapshot[]

  @@unique([documentId, version])
  @@index([organizationId, documentId])
  @@map("vault_document_versions")
}

model TenderWorkspace {
  id                   String   @id @default(cuid())
  organizationId       String
  organizationTenderId String?  @unique
  name                 String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationTender OrganizationTender?          @relation(fields: [organizationTenderId], references: [id], onDelete: SetNull)
  documentRefs       TenderWorkspaceDocumentRef[]

  @@index([organizationId])
  @@map("tender_workspaces")
}

/// Live reference from a tender workspace to a company vault document (no file copy).
model TenderWorkspaceDocumentRef {
  id                String   @id @default(cuid())
  workspaceId       String
  documentId        String
  documentVersionId String?
  purpose           String?
  folderHint        String?
  linkedByUserId    String?
  createdAt         DateTime @default(now())

  workspace       TenderWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document        VaultDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion VaultDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, documentId])
  @@index([documentId])
  @@index([documentVersionId])
  @@map("tender_workspace_document_refs")
}

/// Exact document versions used in a finalized submission (audit-safe).
model SubmissionDocumentSnapshot {
  id                String   @id @default(cuid())
  organizationId    String
  submissionId      String
  documentId        String
  documentVersionId String
  purpose           String?
  nameSnapshot      String
  storageKeySnapshot String
  capturedAt        DateTime @default(now())

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission      Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  document        VaultDocument        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentVersion VaultDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([organizationId, submissionId])
  @@map("submission_document_snapshots")
}

// ---------------------------------------------------------------------------
// Global ingestion ops (not tenant-owned)
// ---------------------------------------------------------------------------

model IngestionMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("ingestion_meta")
}

model PollRun {
  id          String   @id @default(cuid())
  startedAt   DateTime
  finishedAt  DateTime?
  success     Boolean?
  error       String?
  fetched     Int      @default(0)
  newCount    Int      @default(0)
  matching    Int      @default(0)
  notified    Int      @default(0)
  bootstrap   Boolean  @default(false)
  durationMs  Int?

  @@index([startedAt])
  @@map("poll_runs")
}

enum SaasJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Durable product jobs (email outbox, digests). Auth/security mail stays direct SMTP.
model SaasJob {
  id             String        @id @default(cuid())
  organizationId String?
  type           String
  /// Idempotent reservation key (e.g. WEEKLY_DIGEST:org:cycle).
  deliveryKey    String        @unique
  payload        Json?
  status         SaasJobStatus @default(PENDING)
  priority       Int           @default(100)
  availableAt    DateTime      @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attempts       Int           @default(0)
  maxAttempts    Int           @default(8)
  lastError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, priority])
  @@index([organizationId, type, status])
  @@index([leaseExpiresAt])
  @@map("saas_jobs")
}

/// First-party product analytics for Ops Desk. No FK so events survive deletes.
model ProductEvent {
  id             String   @id @default(cuid())
  type           String
  userId         String?
  organizationId String?
  sessionId      String?
  requestId      String?
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([sessionId, createdAt])
  @@map("product_events")
}
