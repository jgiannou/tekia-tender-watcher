# syntax=docker/dockerfile:1.7
# ARC Tenders SaaS API — Coolify / production
# Domain: https://arc-tenders.tekia.gr (nginx web proxies /api here)

FROM node:22-bookworm-slim AS build

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma

# postinstall runs prisma generate
RUN pnpm install --frozen-lockfile || pnpm install

COPY tsconfig.json ./
COPY src ./src

RUN pnpm build \
  && pnpm add prisma@6.19.3 --save-prod --ignore-scripts \
  && pnpm prune --prod --ignore-scripts

FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates wget \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /data /app/storage

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    SAAS_ENABLED=true \
    DATABASE_PATH=/data/tenders.db \
    SAAS_STORAGE_DIR=/app/storage

COPY --from=build /app/package.json ./
COPY --from=build /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY docker/saas-api-entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 3000

VOLUME ["/data", "/app/storage"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health >/dev/null || exit 1

CMD ["/entrypoint.sh"]
