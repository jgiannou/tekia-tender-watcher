{
  "name": "tekia-tender-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Internal TEKIA watcher for Greek KIMDIS public procurement opportunities",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm dashboard:typecheck && pnpm --filter @tekia/desktop typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard:dev": "pnpm --filter @tekia/dashboard dev",
    "dashboard:dev:web": "pnpm --filter @tekia/dashboard dev",
    "dashboard:start": "pnpm --filter @tekia/dashboard preview",
    "dashboard:build": "pnpm --filter @tekia/dashboard build",
    "dashboard:typecheck": "pnpm --filter @tekia/dashboard typecheck",
    "desktop:dev": "pnpm --filter @tekia/desktop dev",
    "desktop:build": "pnpm --filter @tekia/desktop build",
    "desktop:package": "pnpm --filter @tekia/desktop package",
    "desktop:package:dir": "pnpm --filter @tekia/desktop package:dir"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.7.11",
    "node-cron": "^4.1.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.32",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
